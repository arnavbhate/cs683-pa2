#include "cache.h"

#define SPP_IPT_ENTRIES  64
#define SPP_IP_TAG_BITS 16
#define SPP_ADDR_BITS 16     
#define SPP_ADDR_MASK  ((1ULL << SPP_ADDR_BITS) - 1)
#define SPP_MAX_STRIDE 63     
#define SPP_UCONF_MAX 3       
#define SPP_UCONF_THRESH 3       


#define SPP_SIG_BITS 12
#define SPP_SIG_MASK ((1 << SPP_SIG_BITS) - 1)
#define SPP_SIG_SHIFT 3


#define SPP_PT_ENTRIES 256    
#define SPP_PCONF_MAX  3      
#define SPP_PCONF_THRESH 1      
#define SPP_PCONF_LA_THRESH  2      


#define SPP_PF_INDEX_BITS 7
#define SPP_PF_ENTRIES (1 << SPP_PF_INDEX_BITS)  
#define SPP_PF_TAG_BITS 10
#define SPP_PF_TAG_MASK ((1 << SPP_PF_TAG_BITS) - 1)

#define SPP_EPOCH_LEN 256 
#define SPP_ACC_HIGH 75     
#define SPP_ACC_LOW  40     
#define SPP_DEG_HIGH 4
#define SPP_DEG_MID  2
#define SPP_DEG_LOW  1
#define SPP_DEG_INIT SPP_DEG_MID


struct SPP_IPT_ENTRY {
    bool valid;        
    uint16_t ip_tag;       
    uint16_t last_addr;   
    int8_t last_stride;  
    uint8_t uconf;        
    uint16_t sig;          
    uint8_t lru;          
};

struct SPP_PT_ENTRY {
    int8_t stride;        
    uint8_t conf;          
};

struct SPP_PF_ENTRY {
    bool valid;        
    uint16_t tag;          
};

static SPP_IPT_ENTRY spp_ipt[SPP_IPT_ENTRIES];
static SPP_PT_ENTRY spp_pt[SPP_PT_ENTRIES];
static SPP_PF_ENTRY spp_pf[SPP_PF_ENTRIES];

static uint32_t spp_epoch_issued = 0;  
static uint32_t spp_epoch_useful = 0;  
static uint32_t spp_degree = SPP_DEG_INIT;  

static uint64_t stat_issued = 0, stat_useful = 0;
static uint64_t stat_uniform_pf = 0, stat_pattern_pf = 0;
static uint64_t stat_epochs_high = 0, stat_epochs_mid = 0, stat_epochs_low = 0;


static inline uint16_t spp_ip_hash(uint64_t ip){
    return (uint16_t)((ip ^ (ip >> 16) ^ (ip >> 32) ^ (ip >> 48)) & 0xFFFF);
}

static inline uint16_t spp_sig_update(uint16_t sig, int stride){
    return (uint16_t)(((sig << SPP_SIG_SHIFT) ^ (uint16_t)(stride & 0x7F)) & SPP_SIG_MASK);
}

static inline uint32_t spp_pt_index(uint16_t sig){
    return (uint32_t)((sig ^ (sig >> 4)) & (SPP_PT_ENTRIES - 1));
}

static inline uint32_t spp_pf_index(uint64_t cl){ 
    return (uint32_t)(cl & (SPP_PF_ENTRIES - 1)); 
}

static inline uint16_t spp_pf_tag(uint64_t cl){
    return (uint16_t)((cl >> SPP_PF_INDEX_BITS) & SPP_PF_TAG_MASK); 
}

static inline void spp_ipt_touch(int idx)
{
    for (int i = 0; i < SPP_IPT_ENTRIES; i++)
        if (spp_ipt[i].lru < spp_ipt[idx].lru)
            spp_ipt[i].lru++;
    spp_ipt[idx].lru = 0;
}

static inline void spp_throttle()
{
    if (spp_epoch_issued < SPP_EPOCH_LEN)
        return;

    uint32_t acc = (spp_epoch_useful * 100)/spp_epoch_issued;
    if (acc > 100) acc = 100; 

    if (acc >= SPP_ACC_HIGH) {
        spp_degree = SPP_DEG_HIGH;
        stat_epochs_high++; 
    }
    else if (acc >= SPP_ACC_LOW) {
        spp_degree = SPP_DEG_MID;  
        stat_epochs_mid++;
    }
    else {
        spp_degree = SPP_DEG_LOW;    
        stat_epochs_low++;
    }

    spp_epoch_issued = 0;
    spp_epoch_useful = 0;
}

void CACHE::l1d_prefetcher_initialize()
{
    std::cout << "------------------------------------------------" << std::endl;
    std::cout << "        Stride Pattern Prefetcher (SPP)         " << std::endl;
    std::cout << "------------------------------------------------" << std::endl;

    for (int i = 0; i < SPP_IPT_ENTRIES; i++) {
        spp_ipt[i].valid = false;
        spp_ipt[i].ip_tag = 0;
        spp_ipt[i].last_addr = 0;
        spp_ipt[i].last_stride = 0;
        spp_ipt[i].uconf = 0;
        spp_ipt[i].sig = 0;
        spp_ipt[i].lru = i;
    }
    for (int i = 0; i < SPP_PT_ENTRIES; i++) {
        spp_pt[i].stride = 0;
        spp_pt[i].conf = 0;
    }
    for (int i = 0; i < SPP_PF_ENTRIES; i++) {
        spp_pf[i].valid = false;
        spp_pf[i].tag = 0;
    }
    spp_epoch_issued = 0;
    spp_epoch_useful = 0;
    spp_degree = SPP_DEG_INIT;
}

void CACHE::l1d_prefetcher_operate(uint64_t addr, uint64_t ip, uint8_t cache_hit, uint8_t type, uint8_t critical_ip_flag)
{
    uint64_t cl_addr = addr >> LOG2_BLOCK_SIZE;

    {
        SPP_PF_ENTRY &f = spp_pf[spp_pf_index(cl_addr)];
        if (f.valid && f.tag == spp_pf_tag(cl_addr)) {
            spp_epoch_useful++;
            stat_useful++;
            f.valid = false;
        }
    }

    uint16_t tag = spp_ip_hash(ip);
    int index = -1;
    for (int i = 0; i < SPP_IPT_ENTRIES; i++) {
        if (spp_ipt[i].valid && spp_ipt[i].ip_tag == tag) { index = i; break; }
    }

    if (index == -1) {
        for (int i = 0; i < SPP_IPT_ENTRIES; i++) {
            if (spp_ipt[i].lru == (SPP_IPT_ENTRIES - 1)) { index = i; break; }
        }
        assert(index != -1);
        SPP_IPT_ENTRY &n = spp_ipt[index];
        n.valid = true;
        n.ip_tag = tag;
        n.last_addr = (uint16_t)(cl_addr & SPP_ADDR_MASK);
        n.last_stride = 0;
        n.uconf = 0;
        n.sig = 0;
        spp_ipt_touch(index);
        return;
    }

    SPP_IPT_ENTRY &e = spp_ipt[index];
    spp_ipt_touch(index);

    int32_t stride = (int32_t)((cl_addr - (uint64_t)e.last_addr) & SPP_ADDR_MASK);
    if (stride & (1 << (SPP_ADDR_BITS - 1)))
        stride -= (1 << SPP_ADDR_BITS);

    if (stride == 0)         
        return;

    e.last_addr = (uint16_t)(cl_addr & SPP_ADDR_MASK);

    if (stride > SPP_MAX_STRIDE || stride < -SPP_MAX_STRIDE) {
        e.last_stride = 0;
        e.uconf = 0;
        e.sig = 0;
        return;
    }

    if (stride == e.last_stride) {
        if (e.uconf < SPP_UCONF_MAX) e.uconf++;
    } else {
        if (e.uconf > 0) e.uconf--;
    }
    e.last_stride = (int8_t)stride;

    {
        SPP_PT_ENTRY &p = spp_pt[spp_pt_index(e.sig)];
        if (p.stride == stride) {
            if (p.conf < SPP_PCONF_MAX) p.conf++;
        } else if (p.conf > 0) {
            p.conf--;
        } else {
            p.stride = (int8_t)stride;
            p.conf = 0;
        }
    }

    e.sig = spp_sig_update(e.sig, stride);

    auto issue = [&](uint64_t pf_cl) -> bool {
        uint64_t pf_address = pf_cl << LOG2_BLOCK_SIZE;
        if ((pf_address >> LOG2_PAGE_SIZE) != (addr >> LOG2_PAGE_SIZE))
            return false;

        int fill_level = (MSHR.occupancy < (MSHR.SIZE >> 1)) ? FILL_L1 : FILL_L2;

        if (prefetch_line(ip, addr, pf_address, fill_level, 0)) {
            SPP_PF_ENTRY &f = spp_pf[spp_pf_index(pf_cl)];
            f.valid = true;
            f.tag = spp_pf_tag(pf_cl);
            spp_epoch_issued++;
            stat_issued++;
        }
        return true;
    };

    if (e.uconf >= SPP_UCONF_THRESH) {
        for (uint32_t k = 1; k <= spp_degree; k++) {
            if (!issue(cl_addr + (int64_t)stride * k)) break;
            stat_uniform_pf++;
        }
    } else {
        uint16_t la_sig = e.sig;
        uint64_t pf_cl = cl_addr;
        for (uint32_t k = 0; k < spp_degree; k++) {
            SPP_PT_ENTRY &q = spp_pt[spp_pt_index(la_sig)];
            uint32_t need = (k == 0) ? SPP_PCONF_THRESH : SPP_PCONF_LA_THRESH;
            if (q.stride == 0 || q.conf < need)
                break;
            pf_cl += (int64_t)q.stride;
            if (!issue(pf_cl)) break;
            stat_pattern_pf++;
            la_sig = spp_sig_update(la_sig, q.stride); 
        }
    }
    spp_throttle();
}

void CACHE::l1d_prefetcher_cache_fill(uint64_t v_addr, uint64_t addr, uint32_t set, uint32_t way, uint8_t prefetch, uint64_t v_evicted_addr, uint64_t evicted_addr, uint32_t metadata_in)
{
    return; //metadata_in;
}

void CACHE::l1d_prefetcher_final_stats()
{
    const uint64_t ipt_bits = (uint64_t)SPP_IPT_ENTRIES * (1 + SPP_IP_TAG_BITS + SPP_ADDR_BITS + 7 + 2 + SPP_SIG_BITS + 6);
    const uint64_t pt_bits  = (uint64_t)SPP_PT_ENTRIES * (7 + 2);
    const uint64_t pf_bits  = (uint64_t)SPP_PF_ENTRIES * (1 + SPP_PF_TAG_BITS);
    const uint64_t thr_bits = 9 + 9 + 3;
    const uint64_t total    = ipt_bits + pt_bits + pf_bits + thr_bits;

    std::cout << "------------------------------------------------" << std::endl;
    std::cout << "CPU " << cpu << " L1D SPP final stats" << std::endl;
    std::cout << "SPP issued prefetches:   " << stat_issued << std::endl;
    std::cout << "SPP useful (filter hit): " << stat_useful << std::endl;
    std::cout << "SPP internal accuracy:   "
              << (stat_issued ? (100.0 * stat_useful / stat_issued) : 0.0) << " %" << std::endl;
    std::cout << "SPP uniform prefetches:  " << stat_uniform_pf << std::endl;
    std::cout << "SPP pattern prefetches:  " << stat_pattern_pf << std::endl;
    std::cout << "SPP epochs high/mid/low: " << stat_epochs_high << " / "
              << stat_epochs_mid << " / " << stat_epochs_low << std::endl;
    std::cout << "SPP final degree:        " << spp_degree << std::endl;
    std::cout << "SPP storage: IPT " << ipt_bits << " + PT " << pt_bits
              << " + Filter " << pf_bits << " + Throttle " << thr_bits
              << " = " << total << " bits (" << total / 8.0 << " bytes)" << std::endl;
    std::cout << "------------------------------------------------" << std::endl;
}
