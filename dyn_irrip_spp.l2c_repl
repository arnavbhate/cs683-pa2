#include "cache.h"
#include <cstdint>

// CS683 PA2 Task 3: prefetch-aware Dynamic I-RRIP.
// Task 2B set-dueling/threshold selection is preserved. Lines installed by
// an L2 PREFETCH are inserted at max RRPV and are first candidates among
// equally old lines until a demand access uses them.
#ifndef DYN_IRRIP_THRESHOLD
#define DYN_IRRIP_THRESHOLD 0.40
#endif

static constexpr uint32_t DYN_MAX_RRPV = 7;
static constexpr uint32_t DYN_LEADER_MOD = 32;
static constexpr uint32_t DYN_RRIP_LEADER_REMAINDER = 0;
static constexpr uint32_t DYN_IRRIP_LEADER_REMAINDER = 1;

uint32_t dyn_l2_rrpv[L2C_SET][L2C_WAY];
uint8_t dyn_l2_unused_prefetch[L2C_SET][L2C_WAY];
uint64_t dyn_l2_prefetch_fills = 0;
uint64_t dyn_l2_prefetch_demand_hits = 0;
uint64_t dyn_l2_prefetch_unused_evictions = 0;
uint64_t dyn_l2_prefetch_hits = 0;

uint64_t dyn_rrip_instruction_accesses = 0;
uint64_t dyn_rrip_data_accesses = 0;
uint64_t dyn_rrip_instruction_misses = 0;
uint64_t dyn_rrip_data_misses = 0;
uint64_t dyn_follower_rrip_accesses = 0;
uint64_t dyn_follower_rrip_misses = 0;
uint64_t dyn_follower_irrip_accesses = 0;
uint64_t dyn_follower_irrip_misses = 0;
uint64_t dyn_irrip_instruction_accesses = 0;
uint64_t dyn_irrip_data_accesses = 0;
uint64_t dyn_irrip_instruction_misses = 0;
uint64_t dyn_irrip_data_misses = 0;

static inline bool dyn_is_demand(uint32_t type)
{
    return type == LOAD || type == RFO;
}
static inline bool dyn_is_rrip_leader(uint32_t set)
{
    return (set % DYN_LEADER_MOD) == DYN_RRIP_LEADER_REMAINDER;
}
static inline bool dyn_is_irrip_leader(uint32_t set)
{
    return (set % DYN_LEADER_MOD) == DYN_IRRIP_LEADER_REMAINDER;
}
static inline double dyn_instruction_pressure()
{
    const uint64_t total_accesses = dyn_rrip_instruction_accesses + dyn_rrip_data_accesses;
    const uint64_t total_misses = dyn_rrip_instruction_misses + dyn_rrip_data_misses;
    const uint64_t denominator = total_accesses + total_misses;
    if (denominator == 0) return 0.0;
    const uint64_t numerator = dyn_rrip_instruction_accesses + dyn_rrip_instruction_misses;
    return static_cast<double>(numerator) / static_cast<double>(denominator);
}
static inline bool dyn_use_irrip(uint32_t set)
{
    if (dyn_is_rrip_leader(set)) return false;
    if (dyn_is_irrip_leader(set)) return true;
    return dyn_instruction_pressure() > DYN_IRRIP_THRESHOLD;
}

void CACHE::l2c_initialize_replacement()
{
    cout << "Initialize SPP-aware Dynamic I-RRIP state for L2C" << endl;
    cout << "Dynamic I-RRIP threshold: " << DYN_IRRIP_THRESHOLD << endl;
    cout << "Set dueling: RRIP leaders=set%" << DYN_LEADER_MOD << "==" << DYN_RRIP_LEADER_REMAINDER
         << ", I-RRIP leaders=set%" << DYN_LEADER_MOD << "==" << DYN_IRRIP_LEADER_REMAINDER << endl;
    for (uint32_t set = 0; set < L2C_SET; ++set) {
        for (uint32_t way = 0; way < L2C_WAY; ++way) {
            dyn_l2_rrpv[set][way] = DYN_MAX_RRPV;
            dyn_l2_unused_prefetch[set][way] = 0;
        }
    }
    dyn_l2_prefetch_fills = dyn_l2_prefetch_demand_hits = 0;
    dyn_l2_prefetch_unused_evictions = dyn_l2_prefetch_hits = 0;
    dyn_rrip_instruction_accesses = dyn_rrip_data_accesses = 0;
    dyn_rrip_instruction_misses = dyn_rrip_data_misses = 0;
    dyn_follower_rrip_accesses = dyn_follower_rrip_misses = 0;
    dyn_follower_irrip_accesses = dyn_follower_irrip_misses = 0;
    dyn_irrip_instruction_accesses = dyn_irrip_data_accesses = 0;
    dyn_irrip_instruction_misses = dyn_irrip_data_misses = 0;
}

uint32_t CACHE::l2c_find_victim(uint32_t cpu, uint64_t instr_id, uint32_t set,
                                const BLOCK *current_set, uint64_t ip,
                                uint64_t full_addr, uint32_t type)
{
    (void)cpu; (void)instr_id; (void)ip; (void)full_addr; (void)type;
    const bool instruction_mode = dyn_use_irrip(set);
    while (true) {
        bool has_max = false;
        for (uint32_t way = 0; way < L2C_WAY; ++way)
            if (dyn_l2_rrpv[set][way] >= DYN_MAX_RRPV) { has_max = true; break; }

        if (has_max) {
            // Evict an unused prefetched line first among max-RRPV candidates.
            for (uint32_t way = 0; way < L2C_WAY; ++way) {
                if (dyn_l2_rrpv[set][way] >= DYN_MAX_RRPV && dyn_l2_unused_prefetch[set][way]) {
                    ++dyn_l2_prefetch_unused_evictions;
                    return way;
                }
            }
            if (instruction_mode) {
                for (uint32_t way = 0; way < L2C_WAY; ++way) {
                    if (dyn_l2_rrpv[set][way] >= DYN_MAX_RRPV && !current_set[way].instruction)
                        return way;
                }
            }
            for (uint32_t way = 0; way < L2C_WAY; ++way)
                if (dyn_l2_rrpv[set][way] >= DYN_MAX_RRPV) return way;
        }
        for (uint32_t way = 0; way < L2C_WAY; ++way)
            if (dyn_l2_rrpv[set][way] < DYN_MAX_RRPV) ++dyn_l2_rrpv[set][way];
    }
}

void CACHE::l2c_update_replacement_state(uint32_t cpu, uint32_t set, uint32_t way,
                                         uint64_t full_addr, uint64_t ip,
                                         uint64_t victim_addr, uint32_t type,
                                         uint8_t hit, uint8_t isInstruction)
{
    (void)cpu; (void)full_addr; (void)ip; (void)victim_addr;

    // A duplicate prefetch hit does not make a prefetched line useful and
    // should not promote it or clear its unused-prefetch marker.
    if (type == PREFETCH) {
        if (hit) {
            ++dyn_l2_prefetch_hits;
            return;
        }
        dyn_l2_rrpv[set][way] = DYN_MAX_RRPV;
        dyn_l2_unused_prefetch[set][way] = 1;
        ++dyn_l2_prefetch_fills;
        return;
    }

    const bool instruction_mode = dyn_use_irrip(set);
    if (hit && dyn_l2_unused_prefetch[set][way] && dyn_is_demand(type)) {
        ++dyn_l2_prefetch_demand_hits;
        dyn_l2_unused_prefetch[set][way] = 0;
    }

    if (dyn_is_demand(type)) {
        if (dyn_is_rrip_leader(set)) {
            if (isInstruction) {
                ++dyn_rrip_instruction_accesses;
                if (!hit) ++dyn_rrip_instruction_misses;
            } else {
                ++dyn_rrip_data_accesses;
                if (!hit) ++dyn_rrip_data_misses;
            }
        } else if (dyn_is_irrip_leader(set)) {
            if (isInstruction) {
                ++dyn_irrip_instruction_accesses;
                if (!hit) ++dyn_irrip_instruction_misses;
            } else {
                ++dyn_irrip_data_accesses;
                if (!hit) ++dyn_irrip_data_misses;
            }
        } else if (instruction_mode) {
            ++dyn_follower_irrip_accesses;
            if (!hit) ++dyn_follower_irrip_misses;
        } else {
            ++dyn_follower_rrip_accesses;
            if (!hit) ++dyn_follower_rrip_misses;
        }
    }

    if (hit) {
        dyn_l2_rrpv[set][way] = instruction_mode ? (isInstruction ? 0 : 2) : 0;
    } else {
        dyn_l2_unused_prefetch[set][way] = 0;
        dyn_l2_rrpv[set][way] = instruction_mode
            ? (isInstruction ? DYN_MAX_RRPV - 3 : DYN_MAX_RRPV - 1)
            : DYN_MAX_RRPV - 1;
    }
}

void CACHE::l2c_replacement_final_stats()
{
    const uint64_t total_accesses = dyn_rrip_instruction_accesses + dyn_rrip_data_accesses;
    const uint64_t total_misses = dyn_rrip_instruction_misses + dyn_rrip_data_misses;
    const double pressure = dyn_instruction_pressure();
    cout << "Dynamic I-RRIP threshold: " << DYN_IRRIP_THRESHOLD << endl;
    cout << "RRIP leader instruction accesses: " << dyn_rrip_instruction_accesses << endl;
    cout << "RRIP leader data accesses: " << dyn_rrip_data_accesses << endl;
    cout << "RRIP leader instruction misses: " << dyn_rrip_instruction_misses << endl;
    cout << "RRIP leader data misses: " << dyn_rrip_data_misses << endl;
    cout << "RRIP leader total accesses: " << total_accesses << endl;
    cout << "RRIP leader total misses: " << total_misses << endl;
    cout << "I-RRIP leader instruction accesses: " << dyn_irrip_instruction_accesses << endl;
    cout << "I-RRIP leader data accesses: " << dyn_irrip_data_accesses << endl;
    cout << "I-RRIP leader instruction misses: " << dyn_irrip_instruction_misses << endl;
    cout << "I-RRIP leader data misses: " << dyn_irrip_data_misses << endl;
    cout << "Follower RRIP demand accesses: " << dyn_follower_rrip_accesses << endl;
    cout << "Follower RRIP demand misses: " << dyn_follower_rrip_misses << endl;
    cout << "Follower I-RRIP demand accesses: " << dyn_follower_irrip_accesses << endl;
    cout << "Follower I-RRIP demand misses: " << dyn_follower_irrip_misses << endl;
    cout << "Final instruction pressure: " << pressure << endl;
    cout << "Follower policy at end: " << ((pressure > DYN_IRRIP_THRESHOLD) ? "I-RRIP" : "RRIP") << endl;
    cout << "L2 prefetch fills: " << dyn_l2_prefetch_fills << endl;
    cout << "L2 prefetch hits (duplicates): " << dyn_l2_prefetch_hits << endl;
    cout << "L2 prefetch-line demand hits (prefetched line later used): " << dyn_l2_prefetch_demand_hits << endl;
    cout << "L2 unused-prefetch evictions: " << dyn_l2_prefetch_unused_evictions << endl;
    const double l2_prefetch_demand_hit_ratio = dyn_l2_prefetch_fills
        ? static_cast<double>(dyn_l2_prefetch_demand_hits) / dyn_l2_prefetch_fills : 0.0;
    cout << "L2 prefetched-line demand-hit ratio (not L1D prefetch accuracy): "
         << l2_prefetch_demand_hit_ratio << endl;
}
